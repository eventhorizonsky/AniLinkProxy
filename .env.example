PORT=8080
UPSTREAM_BASE_URL=https://api.dandanplay.net
UPSTREAM_DANDAN_APP_ID=your_upstream_app_id
UPSTREAM_DANDAN_APP_SECRET=your_upstream_app_secret
JWT_SECRET=change-this-value-at-least-32-chars-long
SQLITE_PATH=./backend/data/proxy.db

# 可选：32 字节随机密钥的 base64，用于加密落库的 AppSecret；不配置则明文存储（兼容旧库）
# SECRET_WRAP_KEY=

# HTTPS 生产环境建议 true，使会话 Cookie 带 Secure
# AUTH_COOKIE_SECURE=true

# 管理台与 API 跨域时必填，例如本机 Vite 前端：http://localhost:5175
# ADMIN_ALLOWED_ORIGIN=http://localhost:5175

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_ADDRESS=noreply@example.com

TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# 人机验证提供方：留空时自动检测（优先 CaptchaLa，其次 Turnstile）；设为 local 则使用纯本地验证码
# （题目与校验均在服务端内存完成，不依赖任何外部服务，适合开发/内网环境）。
# CAPTCHA_PROVIDER=local

# 人机验证：优先使用 CaptchaLa，额度不足时自动降级到上面的 Cloudflare Turnstile。
# 配置了 CAPTCHALA_SITE_KEY 即优先启用 CaptchaLa；未配置则回退使用 Turnstile。
CAPTCHALA_SITE_KEY=app_your_captchala_app_key
CAPTCHALA_SECRET_KEY=your_captchala_app_secret
# CaptchaLa 服务端校验接口（POST /v1/validate，请求头 X-App-Key / X-App-Secret，JSON {"pass_token":...}）。
# CAPTCHALA_VERIFY_URL=https://apiv1.captcha.la/v1/validate
# CaptchaLa 返回的“验证不通过”错误码（会直接拒绝、不降级），逗号分隔；
# 其余错误（quota_exhausted / quota_exceeded / rate_limited / service_online / invalid_app_key 等）将被视为额度/服务不足并降级到 Cloudflare。
# CAPTCHALA_VERIFY_ERROR_CODES=token_expired,challenge_expired,challenge_not_found,invalid_answer,token_already_used,token_not_found
# CaptchaLa 服务端校验单次超时（秒）与网络瞬时错误重试次数。若服务器访问 Cloudflare（apiv1.captcha.la）不稳定，
# 可调大超时；若服务器在中国大陆无法直连 Cloudflare，建议设置 HTTPS_PROXY/NO_PROXY 让 Go 默认 Transport 走代理。
# CAPTCHALA_VERIFY_TIMEOUT_SEC=10
# CAPTCHALA_VERIFY_RETRIES=1

INIT_ADMIN_EMAIL=admin@example.com
INIT_ADMIN_PASSWORD=ChangeMe_123456
